# Custom Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash Size (Default to 8MB or 4MB)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Bluetooth & NimBLE (Required for Matter BLE Commissioning)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

# Enable LwIP IPv6 SLAAC Autoconfig & Route Hooks (Required for Matter over Wi-Fi)
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Disable Wi-Fi SoftAP so Station + BLE Commissioning have full RF priority
CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Matter Crypto & Group Keys
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4

# FreeRTOS Stack & System Configuration
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# Compiler & Optimization
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Matter Logging
CONFIG_ENABLE_CHIP_SHELL=n
CONFIG_CHIP_ENABLE_DNSSD_TESTS=n

# Console over native USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Matter Software Version Number
CONFIG_DEVICE_SOFTWARE_VERSION_NUMBER=3
